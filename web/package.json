{
  "name": "chaterl-web",
  "private": true,
  "version": "0.0.0",
  "description": "Nearby — web client (chatErl codebase)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
