# Copy to .env and fill in. Never commit .env.

# XMPP
XMPP_DOMAIN=chaterl.localhost
# used by geo_service (Phase 3) to build room JIDs
MUC_SUBDOMAIN=muc.chaterl.localhost
# host interface for ports 5280/5222; 0.0.0.0 = whole LAN (dev only)
XMPP_BIND_ADDR=127.0.0.1

# PostgreSQL (MongooseIM internals)
POSTGRES_DB=mongooseim
POSTGRES_USER=mongooseim
POSTGRES_PASSWORD=change-me

# MongoDB (app data). geo_service reads the MONGO_* variables below (see ADR-016).
# comma-separated host[:port] list (1..16), no mongodb:// URI, no IPv6
MONGO_HOSTS=mongo:27017
MONGO_DB=chaterl
# empty = standalone; required when MONGO_HOSTS lists more than one host
MONGO_REPLICA_SET=
# empty (with an empty password) = no authentication; dev Mongo has none
MONGO_USER=
# no double quote or backslash; alphanumeric is safest. Never logged.
MONGO_PASSWORD=
# empty = admin
MONGO_AUTH_SOURCE=
# exactly true or false
MONGO_TLS=false
# empty = the OS trust store; only read when MONGO_TLS=true
MONGO_TLS_CA_FILE=
# empty = 5 (1..50)
MONGO_POOL_SIZE=
# host port for Compass/mongosh: mongodb://localhost:27018
MONGO_HOST_PORT=27018
# Atlas example (see ADR-016 for the limits: SCRAM-SHA-1 user, no mongodb+srv, resolve SRV by hand):
#   MONGO_HOSTS=shard-00-00.example.mongodb.net:27017,shard-00-01.example.mongodb.net:27017,shard-00-02.example.mongodb.net:27017
#   MONGO_REPLICA_SET=atlas-xxxxxx-shard-0
#   MONGO_USER=geo_service
#   MONGO_PASSWORD=<alphanumeric password>
#   MONGO_AUTH_SOURCE=admin
#   MONGO_TLS=true

# geo_service
# port geo_service listens on, published on 127.0.0.1 only; must match VITE_API_URL (change both if 8080 is taken)
GEO_HTTP_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
MONGOOSEIM_ADMIN_URL=http://mongooseim:5551/api/graphql
MONGOOSEIM_ADMIN_USER=admin
MONGOOSEIM_ADMIN_PASSWORD=change-me

# Dev-only: password for the alice/bob test accounts created by infra/mongooseim/dev-seed.sh
DEV_USER_PASSWORD=change-me

# Web client (Vite exposes VITE_* to the browser — nothing secret here)
VITE_API_URL=http://localhost:8080/api
VITE_XMPP_WS_URL=ws://localhost:5280/ws-xmpp
VITE_XMPP_DOMAIN=chaterl.localhost
# Must match the mod_muc host in the MongooseIM config; defaults to muc.<VITE_XMPP_DOMAIN> if unset
VITE_XMPP_MUC_DOMAIN=muc.chaterl.localhost
# Dev only: map tiles for the "Test locations (dev)" map. Empty = no map (the test spots and fields still work).
# An http(s) URL template with {z}, {x} and {y} (optional {s} subdomain, {r} retina). Never included in production builds.
# Privacy: each tile request tells the tile server (and its logs) which area you are viewing, plus your IP.
# OpenStreetMap tile policy (https://operations.osmfoundation.org/policies/tiles/): keep the on-map attribution,
# light interactive use only, no bulk or offline downloading. Browsers send a Referer, which the policy requires.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
