%% Rendered by relx at release start. The values are quoted strings on purpose: an unset
%% variable becomes "", which geo_config rejects (naming the key, never the value).
[
    {geo_service, [
        {http_ip, "${GEO_HTTP_IP}"},
        {http_port, "${GEO_HTTP_PORT}"},
        {mongo_hosts, "${MONGO_HOSTS}"},
        {mongo_db, "${MONGO_DB}"},
        {mongo_replica_set, "${MONGO_REPLICA_SET}"},
        {mongo_user, "${MONGO_USER}"},
        {mongo_password, "${MONGO_PASSWORD}"},
        {mongo_auth_source, "${MONGO_AUTH_SOURCE}"},
        {mongo_tls, "${MONGO_TLS}"},
        {mongo_tls_ca_file, "${MONGO_TLS_CA_FILE}"},
        {mongo_pool_size, "${MONGO_POOL_SIZE}"}
    ]},
    {kernel, [
        {logger_level, info},
        {logger, [
            {handler, default, logger_std_h, #{
                formatter => {logger_formatter, #{single_line => true}}
            }}
        ]}
    ]}
].
