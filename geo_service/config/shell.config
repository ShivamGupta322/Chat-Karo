%% Used by `rebar3 shell` only. 8081 avoids the container's published 8080.
[
    {geo_service, [
        {http_ip, "127.0.0.1"},
        {http_port, "8081"},
        %% Dev MongoDB from docker-compose (published on 127.0.0.1:27018), no auth.
        {mongo_hosts, "127.0.0.1:27018"},
        {mongo_db, "chaterl"},
        {mongo_replica_set, ""},
        {mongo_user, ""},
        {mongo_password, ""},
        {mongo_auth_source, ""},
        {mongo_tls, ""},
        {mongo_tls_ca_file, ""},
        {mongo_pool_size, ""},
        %% Dev-only literal for rebar3 shell: NOT a real secret and never used in a container.
        {jwt_secret, "dev-shell-only-not-a-real-secret-0123456789"},
        {xmpp_domain, "chaterl.localhost"},
        %% 5551 is not published to the host: POST /api/session returns 503 in rebar3 shell.
        {mim_admin_url, "http://127.0.0.1:5551/api/graphql"},
        {mim_admin_user, "admin"},
        {mim_admin_password, "shell-only"}
    ]}
].
