{minimum_otp_vsn, "27"}.

{erl_opts, [debug_info, warnings_as_errors, warn_missing_spec]}.

{deps, [
    {cowboy, "2.21.0"},
    %% Pinned by SHA (master, 3.6.10); transitive deps are pinned in rebar.lock. See ADR-016.
    {mongodb,
        {git, "https://github.com/comtihon/mongodb-erlang.git",
            {ref, "b17302e7f4f128cf2113a665a5d300b66829cd5d"}}}
]}.

{project_plugins, [{erlfmt, "1.9.0"}]}.

{erlfmt, [
    write,
    {files, ["src/*.erl", "src/*.app.src", "test/*.erl", "test/*.hrl", "rebar.config"]}
]}.

{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling]},
    %% Transitive deps (cowboy: cowlib; mongodb: bson, poolboy) that Dialyzer needs in the PLT.
    {plt_extra_apps, [cowlib, bson, poolboy]}
]}.

{relx, [
    {release, {geo_service, "0.1.0"}, [geo_service]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true}
]}.

{shell, [{config, "config/shell.config"}, {apps, [geo_service]}]}.

{profiles, [
    {test, [
        {deps, [{proper, "1.5.0"}]},
        {erl_opts, [nowarn_missing_spec]}
    ]},
    {prod, [
        {relx, [{mode, prod}]}
    ]}
]}.
